# The application's settings inside the Docker stack (docs/docker.md). Every
# key is explained in .env.example; here are only the ones that differ from
# it or that the stack depends on.
#
# The entrypoint (docker/php/entrypoint.sh) copies this file into each PHP
# container's .env. After a change, run the usual command again:
#   docker compose up -d --build
#
# APP_URL is not here: the entrypoint writes it from the port the site is
# published on (APP_PORT, see docker-compose.yml). Set it here only to use
# an address of your own.

APP_NAME="Vrelina juga"
# "local" is what lets the seeder add the demo producers and the demo
# accounts (Database\Seeders\DatabaseSeeder).
APP_ENV=local
# Empty: a key is generated on the first start and kept in the storage
# volume. Fill it in to use a key of your own.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Belgrade

APP_LOCALE=sr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The "mysql" container. The same name, user and password are in
# docker-compose.yml, where the database is created.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vrelina_juga
DB_USERNAME=vrelina
DB_PASSWORD=vrelina

# The "redis" container, for all three. To run the stack without Redis, set
# them back to "database", as in .env.example.
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
# Sessions and queued jobs in one numbered database, the cache in another:
# `php artisan cache:clear` then empties the cache and nothing else.
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public

# Nothing is sent: every e-mail (address confirmation, password reset) is
# written to storage/logs/laravel.log, link included.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The image has MariaDB's client, whose dump program goes by this name.
BACKUP_MYSQLDUMP=mariadb-dump
