# .env for the live site. Copy to the project folder as .env, fill in
# every value under a "CHANGE" line, then: php artisan key:generate
# Every key here is explained in .env.example and docs/scaling.md.

APP_NAME="Vrelina juga"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# CHANGE: the site's address
APP_URL=https://example.rs

APP_LOCALE=sr
APP_FALLBACK_LOCALE=sr
APP_FAKER_LOCALE=sr_RS

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vrelina_juga
# CHANGE: the database user, and a long random password
DB_USERNAME=vrelina
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MEDIA_DISK=public

# CHANGE: mail, e.g. Brevo (free up to 300 a day).
# Test with: php artisan mail:test you@example.com
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.rs"
MAIL_FROM_NAME="${APP_NAME}"

# CHANGE: robot check on registration and password reset (dash.cloudflare.com -> Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: "Nastavi sa Google nalogom" (console.cloud.google.com -> Credentials,
# redirect URI https://your-domain/auth/google/callback). Empty hides the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CHANGE: error reports (sentry.io, free project)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Nightly database backup. Move BACKUP_DISK off this server once there is
# somewhere to put it.
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14
BACKUP_MYSQLDUMP=mysqldump
# CHANGE: where to hear about a failed backup
BACKUP_NOTIFY_EMAIL=

CSP_REPORT_ONLY=false
