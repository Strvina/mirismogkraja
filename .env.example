APP_NAME="Vrelina juga"
APP_ENV=local
APP_KEY=
# Set to false and APP_ENV=production before deploying (task 8.5) - debug
# mode exposes stack traces and env values to visitors.
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Podaci sa uplatnice za članarinu proizvođača (zadatak 20.1). Plaćanje ide
# preko uplatnice, pa ovi podaci završe odštampani na papiru.
PLATFORM_PAYMENT_RECIPIENT="Vrelina juga"
PLATFORM_PAYMENT_ACCOUNT="000-0000000000000-00"
PLATFORM_PAYMENT_PURPOSE="Članarina za Vrelina juga"
PLATFORM_PAYMENT_ADDRESS=""
PLATFORM_PAYMENT_MODEL="97"
# Šifra plaćanja: 221 je promet robe i usluga sa računa.
PLATFORM_PAYMENT_CODE="221"

VITE_APP_NAME="${APP_NAME}"
