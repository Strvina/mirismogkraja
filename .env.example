APP_NAME="Vrelina juga"
APP_ENV=local
APP_KEY=
# Set to false and APP_ENV=production before deploying (task 8.5) - debug
# mode exposes stack traces and env values to visitors.
APP_DEBUG=true
APP_TIMEZONE=Europe/Belgrade
APP_URL=http://localhost

# Serbian (Latin): validation messages in lang/sr, and dates such as a
# membership's end date in the notifications.
APP_LOCALE=sr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Error reports to Sentry (sentry.io, free tier). Empty: errors only go to
# the log. Traces (performance) are off; e.g. 0.05 samples 5% of requests.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Content-Security-Policy as report-only, if something on a live site turns
# out to be blocked (see App\Http\Middleware\SecurityHeaders).
CSP_REPORT_ONLY=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sessions, cache and queue live in MySQL, which needs nothing else on the
# server. With many visitors at once, switch all three to "redis" (see
# docs/scaling.md) - REDIS_CLIENT=predis works without a PHP extension.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Where uploaded images are kept: "public" on one server, "s3" once there
# are several (needs league/flysystem-aws-s3-v3 and the AWS_* values).
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cloudflare Turnstile on registration and password reset. Free keys at
# dash.cloudflare.com -> Turnstile; leave empty to turn the check off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# "Nastavi sa Google nalogom". Free OAuth client at console.cloud.google.com
# -> APIs & Services -> Credentials (type: Web application), with
# https://your-domain/auth/google/callback as an authorised redirect URI.
# Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nightly database backup (php artisan backup:database, see config/backup.php).
# Use a disk on another machine (e.g. s3) once there is one.
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14
BACKUP_MYSQLDUMP=mysqldump
BACKUP_NOTIFY_EMAIL=

# Outgoing mail (the password reset link). "log" only writes it to the log.
# On the server use an SMTP service, e.g. Brevo: smtp-relay.brevo.com, port
# 587, tls (free up to 300 a day). Add the SPF and DKIM DNS records it gives
# for the sender's domain, or the mail lands in spam.
# Check the settings with: php artisan mail:test you@example.com
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The address visitors write to, shown in the footer and on /kontakt.
PLATFORM_CONTACT_EMAIL=zdravo@vrelinajuga.rs

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
